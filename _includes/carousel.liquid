{% if page.gallery %}

<style>
  /* 1. Increase the size of the arrow icons */
  #labPhotoGallery .carousel-control-prev-icon,
  #labPhotoGallery .carousel-control-next-icon {
    width: 3rem;  /* Increased from default 2rem */
    height: 3rem; /* Increased from default 2rem */
  }
  
  /* 2. Move them closer to the edges */
  #labPhotoGallery .carousel-control-prev,
  #labPhotoGallery .carousel-control-next {
    width: 7%; /* Decreased from default 15% to pull them outward */
  }
</style>

<div id="labPhotoGallery" class="carousel slide mb-4" data-interval="false">
  
  <ol class="carousel-indicators">
    {% for image in page.gallery %}
      <li data-target="#labPhotoGallery" data-slide-to="{{ forloop.index0 }}" class="{% if forloop.first %}active{% endif %}"></li>
    {% endfor %}
  </ol>

  <div class="carousel-inner">
    {% for image in page.gallery %}
      <div class="carousel-item {% if forloop.first %}active{% endif %}">
        <img src="{{ image | relative_url }}" class="d-block w-100" style="height: 500px; object-fit: cover;" alt="Gallery Image {{ forloop.index }}">
      </div>
    {% endfor %}
  </div>

  <a class="carousel-control-prev" href="#labPhotoGallery" role="button" data-slide="prev">
    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
    <span class="sr-only">Previous</span>
  </a>
  <a class="carousel-control-next" href="#labPhotoGallery" role="button" data-slide="next">
    <span class="carousel-control-next-icon" aria-hidden="true"></span>
    <span class="sr-only">Next</span>
  </a>
</div>
{% endif %}